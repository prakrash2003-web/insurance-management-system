# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The defaults below are safe for local development as-is, EXCEPT the secret key.

# --- Core ---------------------------------------------------------------
# REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-50-character-random-string

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames (no scheme, no port).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins WITH scheme. Needed behind HTTPS / a proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Production only: set False to disable the automatic HTTP->HTTPS redirect
# (e.g. when TLS is terminated upstream). Ignored while DEBUG=True.
# DJANGO_SECURE_SSL_REDIRECT=True

# --- Database ----------------------------------------------------------
# Leave unset (commented) to use the local SQLite file.
# Set to a Postgres URL in production (Railway provides one automatically):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DJANGO_DB_CONN_MAX_AGE=600            # seconds; use >0 for a managed Postgres

# --- Email (contact form / password reset) ---------------------------
# Console backend prints emails to the runserver console - fine for development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Insurance Management <no-reply@example.com>
CONTACT_RECEIVING_EMAILS=admin@example.com

# For real SMTP instead, comment out the console backend above and set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Production (Railway) ---------------------------------------------
# Set these in the Railway service "Variables" tab (NOT in a committed file):
#   DJANGO_SECRET_KEY    = <generate a fresh 50-char key, not the dev one>
#   DJANGO_DEBUG         = False
#   DJANGO_ALLOWED_HOSTS = your-app.up.railway.app   (the exact generated domain;
#                          add a custom domain here too, comma-separated)
#   DJANGO_CSRF_TRUSTED_ORIGINS = https://your-app.up.railway.app
#   DATABASE_URL         = ${{Postgres.DATABASE_URL}}   (reference the PG service)
#
# Notes:
# * Paste the hostname only - no scheme, no port, no quotes, no spaces.
# * If DJANGO_ALLOWED_HOSTS is left unset on Railway, settings.py falls back to
#   trusting *.up.railway.app / *.railway.app so the site still loads. Setting
#   the exact domain is still preferred.
# * settings.py auto-derives the matching https:// CSRF origin from each host,
#   so DJANGO_CSRF_TRUSTED_ORIGINS is optional unless you use extra origins.
