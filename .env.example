# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---------------------------------------------------------------
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (no scheme, no port).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins for CSRF (scheme required). Needed behind HTTPS/proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# --- Database ----------------------------------------------------------
# Defaults to local SQLite when unset. Example Postgres URL:
# DATABASE_URL=postgres://user:password@localhost:5432/insurance
DATABASE_URL=

# --- Email (contact form / notifications) -----------------------------
# Defaults to console backend (prints emails to stdout) when unset.
# For real SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Insurance Management <no-reply@example.com>
CONTACT_RECEIVING_EMAILS=admin@example.com
